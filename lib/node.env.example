# A node for node-crashtest. Copy to ~/.config/node-crashtest/nodes/NAME.env (NAME is how the scripts
# refer to it) and adapt. Values below are the defaults where there is one.

# The ssh destination (an alias from ~/.ssh/config works). The user needs sudo without a password.
NODE=t-node
# Optional: an ssh config file of the node's own, used instead of ~/.ssh/config (ssh -F); provision/vm.sh
# writes one per VM.
SSH_CONFIG=
# The node's libvirt domain (qemu:///system), for power and link faults.
VM=t-node
# mainnet, sepolia or hoodi: picks the reference RPC the checks compare with.
NETWORK=hoodi

# The node's systemd unit, the user it runs as (partial cuts filter that user's traffic), its data
# directory (the watcher shows the use of its file system), and its JSON-RPC as reached on the node.
SERVICE=geth
SERVICE_USER=geth
DATADIR=/var/lib/geth
RPC=http://127.0.0.1:8545

# Optional: a file whose mtime and size the watcher shows (e.g. a light client's checkpoint file).
WATCH_FILE=
# Optional: the first block of the node's history, or a command that prints it on the node (the
# log index check spreads its windows from there to the head).
HISTORY_START=
HISTORY_START_CMD=

# Required for any fault: marks the node as a test node, which may lose power, network or disk.
FAULTS_OK=
